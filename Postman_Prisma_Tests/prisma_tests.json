						{
							"name": "create/make3Tasks",
							"event": [
								{
									"listen": "prerequest",
									"script": {
										"id": "55df245d-c826-4189-8ff5-b18ad16226ea",
										"exec": [
											"// pm.collectionVariables.set(\"taskIds\", JSON.stringify([]));",
											"// pm.variables.set(\"tasksToCreate\", 3);",
											"// pm.variables.set(\"baseTitle\", `Lewis Task ${Date.now()}`);",
											"",
											"const registeredEmail = pm.collectionVariables.get(\"registeredEmail\");",
											"pm.variables.set(\"loginEmail\", registeredEmail || \"test@example.com\");",
											"pm.variables.set(\"timestamp\", Date.now());"
										],
										"type": "text/javascript",
										"packages": {},
										"requests": {}
									}
								},
								{
									"listen": "test",
									"script": {
										"id": "375584d0-4725-49f8-8cfb-69a5fa21c2e0",
										"exec": [
											"const taskIds = JSON.parse(pm.collectionVariables.get(\"taskIds\")) || [];",
											"",
											"pm.test(\"✅ Created multiple tasks successfully\", () => {",
											"    pm.expect(pm.response.code).to.equal(201);",
											"});",
											"",
											"// This is a bit advanced — it chains creates using pm.sendRequest",
											"function createTask(index) {",
											"    if (index === 0) {",
											"        pm.collectionVariables.set(\"taskIds\", JSON.stringify(taskIds));",
											"        console.log(\"✅ All tasks created. Saved IDs:\", taskIds);",
											"        return;",
											"    }",
											"",
											"    const title = `${pm.variables.get(\"baseTitle\")} #${index + 1}`;",
											"",
											"    const requestBody = {",
											"        title: title,",
											"        isCompleted: false",
											"    };",
											"",
											"    pm.sendRequest({",
											"        url: pm.request.url,",
											"        method: \"POST\",",
											"        header: { \"Content-Type\": \"application/json\" },",
											"        body: {",
											"            mode: \"raw\",",
											"            raw: JSON.stringify(requestBody)",
											"        }",
											"    }, (err, res) => {",
											"        if (err) {",
											"            console.error(\"Error creating task\", index, err);",
											"            return;",
											"        }",
											"",
											"        const data = res.json();",
											"        taskIds.push(data.id);",
											"",
											"        pm.test(`✅ Task ${index + 1} created - ID: ${data.id}`, () => {",
											"            pm.expect(data).to.have.property(\"id\");",
											"            pm.expect(data.title).to.include(\"Lewis Task\");",
											"        });",
											"",
											"        createTask(index - 1); ",
											"    });",
											"}",
											"",
											"// Start creating tasks",
											"createTask(3);"
										],
										"type": "text/javascript",
										"packages": {},
										"requests": {}
									}
								}
							],
