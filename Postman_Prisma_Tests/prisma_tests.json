								"exec": [
									"const jsonData = pm.response.json();",
									"",
									"pm.test(\"✅ Status code is 400 for duplicate email\", () => {",
									"    pm.expect(pm.response.code).to.equal(400);",
									"});",
									"",
									"pm.test(\"✅ Returns 'Email already registered' message\", () => {",
									"    pm.expect(jsonData).to.have.property(\"message\");",
									"    pm.expect(jsonData.message).to.equal(\"Email already registered\");",
									"});",
									"",
									"pm.test(\"✅ No validation details (it's a duplicate, not schema error)\", () => {",
									"    pm.expect(jsonData).to.not.have.property(\"details\");",
									"});",
