		{
			"name": "Register Tests",
			"item": [
				{
					"name": "register/success",
					"event": [
						{
							"listen": "test",
							"script": {
								"id": "2c9e2e04-23ab-4c7f-9034-f2ae30a8e5ad",
								"exec": [
									"const jsonData = pm.response.json();",
									"",
									"pm.test(\"✅ Status code is 201 Created\", () => {",
									"      //just to make sure it can fail.",
									"    // never trust tests that wont fail",
									"    // pm.expect(pm.response.code).to.equal(200);",
									"    pm.expect(pm.response.code).to.equal(201);",
									"});",
									"",
									"pm.test(\"✅ Response has name and email\", () => {",
									"    pm.expect(jsonData).to.have.property(\"name\").that.is.a(\"string\");",
									"    pm.expect(jsonData).to.have.property(\"email\").that.is.a(\"string\");",
									"});",
									"",
									"pm.test(\"✅ Returned email matches the one we sent\", () => {",
									"    pm.expect(jsonData.email).to.equal(pm.variables.get(\"uniqueEmail\"));",
									"});",
									"",
									"pm.test(\"✅ No password or hashedPassword leaked\", () => {",
									"    pm.expect(jsonData).to.not.have.property(\"password\");",
									"    pm.expect(jsonData).to.not.have.property(\"hashedPassword\");",
									"});",
									"",
									"pm.test(\"✅ Response time is reasonable\", () => {",
									"    pm.expect(pm.response.responseTime).to.be.below(2000);",
									"});",
									"",
									"// console.log(\"✅ Registration Success Test Passed - User:\", jsonData);",
									"// === NEW: Save the created email for later tests ===",
									"pm.test(\"💾 Save email for duplicate test\", () => {",
									"    pm.collectionVariables.set(\"registeredEmail\", jsonData.email);",
									"    console.log(\"💾 Saved email for duplicate test:\", jsonData.email);",
									"});"
								],
								"type": "text/javascript",
								"packages": {},
								"requests": {}
							}
						},
						{
							"listen": "prerequest",
							"script": {
								"id": "6d5e92c3-8c1d-4079-8aaa-eac17824ed04",
								"exec": [
									"// Generate unique email every time",
									"pm.variables.set(\"timestamp\", Date.now());",
									"pm.variables.set(\"uniqueEmail\", `test${pm.variables.get(\"timestamp\")}@example.com`);"
								],
								"type": "text/javascript",
								"packages": {},
